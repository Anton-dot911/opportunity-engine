{
  "name": "opportunity-engine",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm --filter @oe/api dev\" \"pnpm --filter @oe/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}