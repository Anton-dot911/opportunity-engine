{
  "name": "opportunity-engine",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "pnpm --filter @oe/database build && concurrently -k -n api,web -c blue,green \"pnpm --filter @oe/api dev\" \"pnpm --filter @oe/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @oe/database migrate"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "dotenv": "^16.6.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}