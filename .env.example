# Local application configuration
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Local PostgreSQL — matches docker-compose.yml
DATABASE_URL=postgresql://oe:oe_local_dev@localhost:5432/opportunity_engine

# AI provider — credentials will be added when AI Runtime is implemented
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Bounded research defaults (reserved for later phases)
AI_MAX_RETRIES=2
RESEARCH_MAX_ITERATIONS=5
RESEARCH_MAX_DURATION_SECONDS=300
