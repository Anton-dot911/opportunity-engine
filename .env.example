# Local application configuration
NODE_ENV=development
APP_ENV=local
WEB_PORT=5173
API_PORT=3000

# Local PostgreSQL (credentials are for local development only)
DATABASE_URL=postgresql://opportunity:opportunity_local_only@localhost:5432/opportunity_engine

# AI provider — put real credentials in an untracked .env file
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional search adapter (not required in Foundation)
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Bounded research defaults
AI_MAX_RETRIES=2
RESEARCH_MAX_ITERATIONS=5
RESEARCH_MAX_DURATION_SECONDS=300