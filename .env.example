# Local application configuration
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Local PostgreSQL — matches docker-compose.yml
DATABASE_URL=postgresql://oe:oe_local_dev@localhost:5432/opportunity_engine

# Provider-neutral AI Runtime (Anthropic adapter is the first implementation)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_MAX_RETRIES=1
AI_TIMEOUT_MS=30000
# Optional per-million-token rates; estimated cost remains null if rates are omitted
AI_INPUT_COST_PER_MILLION=
AI_OUTPUT_COST_PER_MILLION=

# Bounded Research Loop
RESEARCH_MAX_ITERATIONS=5
